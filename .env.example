# 复制为 .env 后填写；命令行环境变量优先于本文件

# 站点登录账号（不开放注册）
AUTH_USER=admin
AUTH_PASS=change-me

# 监听地址 / 数据库 / 本地对象存储
PORT=:8080
BASE_URL=
SQLITE_PATH=./resource-center.db
DATA_DIR=./data

# Cloudflare R2（书库转存目标；共用下方 CF_ACCOUNT_ID；未配置时兜底本地 DATA_DIR）
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE=

# Cloudflare 监控（只读 API Token）
CF_API_TOKEN=
CF_ACCOUNT_ID=

# Z-Library 书库（默认 jump；direct 模式才使用账号密码）
ZLIB_BASE_URL=https://z-lib.sk
ZLIB_MODE=jump
ZLIB_EMAIL=
ZLIB_PASSWORD=

# Gmail 邮箱（推荐在设置中心完成 OAuth，命令行 --gmail-auth 为备用方式）
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_EMAIL=

# 论坛资源源（pan1.me/123panfx）：自动回帖解锁 + 登录
RESPOOL_ACCOUNT=
RESPOOL_PASSWORD=
RESPOOL_COOKIE=
RESPOOL_REPLY_TEXT=感谢分享，辛苦了！
# RESPOOL_HEADED=true

# 123云盘（推荐全自动）：账密配置后 token 失效自动续期，零维护
PAN123_ACCOUNT=
PAN123_PASSWORD=
# 或纯 token 模式（密码不落盘；失效时手动换新）：./resource-center --pan123-token <账号> <密码>
# PAN123_TOKEN=

# 123云盘开放平台
PAN123_API_BASE=https://open-api.123pan.com
PAN123_CLIENT_ID=
PAN123_CLIENT_SECRET=
PAN123_ACCESS_TOKEN=
